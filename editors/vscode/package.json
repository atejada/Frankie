{
  "name": "frankie-language",
  "displayName": "Frankie Language",
  "description": "Syntax highlighting + language server (diagnostics, completion, hover) for the Frankie programming language (.fk files)",
  "version": "1.18.0",
  "publisher": "frankie-lang",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:frankie"],
  "contributes": {
    "languages": [
      {
        "id": "frankie",
        "aliases": ["Frankie", "frankie"],
        "extensions": [".fk"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "frankie",
        "scopeName": "source.frankie",
        "path": "./frankie.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Frankie",
      "properties": {
        "frankie.lspCommand": {
          "type": "string",
          "default": "frankiec",
          "description": "Command used to launch the Frankie language server (invoked as: <command> lsp). Set an absolute path if frankiec is not on PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.0"
  }
}
